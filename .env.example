# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection String
# PostgreSQL (Cloud Run / Cloud SQL / Local Docker):
# DATABASE_URL="postgresql://moneylogger:moneylogger_secret@localhost:5432/moneylogger?schema=public"
# SQLite (offline local dev/test):
DATABASE_URL="file:./dev.db"

# Security & Sessions (signed session cookies, min 32 chars in production)
SESSION_SECRET="change-this-to-a-secure-random-string-in-production"

# Synthetic Seed Master Password
SEED_PASSWORD="ChangeMeInLocalTesting123!"
