datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMINISTRATOR
}

enum AccountType {
  CASH
  LOAN_TAKEN
  LOAN_GIVEN
  INCOME
  EXPENSE
}

enum AccountSubtype {
  WALLET
  BANK
  CREDIT_CARD
  OTHER_LOAN
  NONE
}

enum TransactionKind {
  OPENING_BALANCE
  RECEIPT
  PAYMENT
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  displayName  String
  role         Role          @default(USER)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  accounts     Account[]
  transactions Transaction[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Account {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             AccountType
  subtype          AccountSubtype   @default(NONE)
  name             String
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  mainTransactions Transaction[]    @relation("MainAccount")
  allocationLines  AllocationLine[] @relation("TargetAccount")

  @@unique([userId, name])
}

model Transaction {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            TransactionKind
  mainAccountId   String
  mainAccount     Account          @relation("MainAccount", fields: [mainAccountId], references: [id], onDelete: Restrict)
  totalMinor      Int
  transactionDate String
  description     String           @default("")
  createdAt       DateTime         @default(now())
  allocations     AllocationLine[]
}

model AllocationLine {
  id              String      @id @default(cuid())
  transactionId   String
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  targetAccountId String
  targetAccount   Account     @relation("TargetAccount", fields: [targetAccountId], references: [id], onDelete: Restrict)
  amountMinor     Int
  memo            String      @default("")
}

